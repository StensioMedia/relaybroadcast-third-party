# Exakta versioner för Windows-appens ffmpeg. Läses av build.sh (source).
# Varje källa är låst till en kontrollsumma eller en commit; ändras en rad här
# ska den kontrolleras på samma sätt som nedan, och datumet skrivas in.
# Licensbyggplanen uppgift 3 (docs/research/byggplan-licenser-2-0-0-2026-10-13.md).
# Där inget annat står är det samma commit som BtbN-bygget Anders provkört
# (autobuild-2026-09-30-13-08 = BtbN 6c9aec5, svaret §B1).

# FFmpeg 9.0.2 — samma tarboll, kontrollsumma och nyckel som Macen
# (scripts/mac-ffmpeg/versions.env, kontrollerad 2026-10-06).
FFMPEG_VERSION=9.0.2
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
FFMPEG_KEY_FINGERPRINT=FCF986EA15E6E293A5644F10B4322F04D67658D8

# x264 — grenen stable, samma commit som Macen (X264_BUILD 165).
# Kontrollerad 2026-10-13: git fetch av commiten, 2025-06-08.
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55

# SRT 1.5.7 — taggen v1.5.7, samma som Macen. Kontrollerad 2026-10-13
# (git ls-remote: taggen pekar på commiten).
SRT_VERSION=1.5.7
SRT_COMMIT=899348d8318eb9a3c5a5b6ec43c4a1114288773a

# Mbed TLS 3.6.7 (LTS) — SRT:s kryptering, tagen under GPL-2.0-or-later.
# Samma releasefil och kontrollsumma som Macen (kontrollerad 2026-10-06).
# --enable-mbedtls i ffmpeg används INTE (det kräver version3); Mbed TLS
# kommer bara in via SRT.
MBEDTLS_VERSION=3.6.7
MBEDTLS_SHA256=a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6

# nv-codec-headers 13.1.15.1 (ffnvcodec.pc.in) — MIT. nvenc, nvdec, cuvid, cuda.
# Kontrollerad 2026-10-13: git fetch av commiten, 2026-07-15.
NVCODEC_COMMIT=eddcea9e27f6b772057c9b3f87de2cc1737faffc

# AMF-huvudfiler 1.5.2 (amf/public/include/core/Version.h) — MIT. h264_amf.
# Kontrollerad 2026-10-13: git fetch av commiten, 2026-09-22.
AMF_COMMIT=6277e353fd625121a8f627b1d0540323ef372a49

# libvpl 2.17.0 (version.txt) — MIT. h264_qsv.
# Kontrollerad 2026-10-13: git fetch av commiten, 2026-07-13.
LIBVPL_COMMIT=674d015bcb294bc39fa276e99a652ea045423e82

# dav1d 1.5.4 (meson.build) — BSD-2-Clause. AV1-källor utan grafikkort
# (Anders beslut 2026-10-13). Kontrollerad 2026-10-13: git fetch, 2026-09-22.
DAV1D_COMMIT=9711965b60bb692ae24004659acf61f5c7d9ed61

# opus (huvudgrenen) — BSD-3-Clause. -c:a libopus (iptv/ffmpeg-cmd.js).
# Kontrollerad 2026-10-13: git fetch av commiten, 2026-09-11.
OPUS_COMMIT=503d81b138d76621aae4b12786e90de48aa8db3a

# zlib 1.3.2.1-motley (zlib.h, grenen develop) — Zlib. http och png.
# Kontrollerad 2026-10-13: git fetch av commiten, 2026-09-20.
ZLIB_COMMIT=767c4c947852e143f582c85f14cf573411df1b35

# libxml2 2.16.0 (VERSION) — MIT. DASH via ffmpeg (iptv/dash-source.js),
# Anders beslut 2026-10-13. Kontrollerad 2026-10-13: git fetch, 2026-09-17.
LIBXML2_COMMIT=91586dc6742ab335682235120363f6e126eea5e2
